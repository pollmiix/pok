{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/produto/:id",
      "destination": "/api/product?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin.php",
      "destination": "/api/admin"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed"
    }
  ]
}
