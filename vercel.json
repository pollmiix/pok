{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/storefront.js": { "includeFiles": "{index.html,catalog.js,catalog-galleries.js}" },
    "api/visits.js": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/storefront"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/storefront"
    },
    {
      "src": "^/produto/([^/]+)/?$",
      "dest": "/api/product?id=$1"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/admin\\.php$",
      "dest": "/api/admin"
    },
    {
      "src": "^/merchant-feed\\.xml$",
      "dest": "/api/merchant-feed"
    },
    { "handle": "filesystem" }
  ]
}
